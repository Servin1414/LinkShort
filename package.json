{
  "name": "linkshort",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c blue,green \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:push": "npm run db:push --workspace backend",
    "db:studio": "npm run db:studio --workspace backend"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "prisma@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3"
  }
}
